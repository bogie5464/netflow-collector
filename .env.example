# NetFlow Collector — environment template.
#
# §10 Bootstrap copies this to .env before the first build. EVERY key below carries a working
# local value on purpose: a variable that only appears later in the build would make an earlier
# step's gate fail the moment its step lands (blueprint.md §9 rule 9). .env is gitignored;
# this file is committed.
#
# internal/config loads the nearest .env by walking UP from the working directory (so `go test`
# inside a package directory still finds it) and never overwrites a variable already exported
# in the shell.

# ---- process ----
NFC_LOG_LEVEL=info
NFC_HTTP_ADDR=:8080
NFC_NETFLOW_ADDR=:2055

# ---- what is enabled ----
# Comma-separated. Sources: netflow, kafka. Sinks: postgres, mariadb, clickhouse.
NFC_SOURCES=netflow
NFC_SINKS=postgres

# ---- storage backends ----
# Host ports come from docker-compose.yml, which owns them (blueprint.md §19.6).
NFC_POSTGRES_DSN=postgres://netflow:netflow@127.0.0.1:15432/netflow?sslmode=disable
NFC_MARIADB_DSN=netflow:netflow@tcp(127.0.0.1:13306)/netflow?parseTime=true&loc=UTC&charset=utf8mb4
NFC_CLICKHOUSE_DSN=clickhouse://netflow:netflow@127.0.0.1:19000/netflow
NFC_RETENTION_DAYS=30

# ---- kafka source ----
NFC_KAFKA_BROKERS=127.0.0.1:19092
NFC_KAFKA_TOPIC=flows
NFC_KAFKA_GROUP=netflow-collector

# ---- pipeline ----
NFC_PIPELINE_BUFFER=65536
NFC_BATCH_SIZE=2000
NFC_BATCH_INTERVAL=1s
NFC_WORKERS=4

# ---- api ----
# Comma-separated bearer keys. Rotate by adding the new key, restarting, moving clients, then
# removing the old one. Generate with: openssl rand -hex 32
NFC_API_KEYS=dev-local-key
