# Build output
/bin/
/dist/

# Local environment. .env.example is the committed template — the negation below guarantees it
# survives `git add -A` even if a broader .env pattern is ever added above it.
.env
.env.*.local
!.env.example

# Go test and profiling artefacts
*.test
*.out

# Editor / OS
.DS_Store
.idea/
.vscode/

# The Architect design bundle. Kept locally for /architect-next and /architect-audit, not
# published: the build it describes is complete.
/blueprints/

# NOT ignored, deliberately: .claude/, .golangci.yml, docker-compose.yml, Dockerfile,
# .dockerignore, .github/, docs/openapi.json, go.mod, go.sum.
